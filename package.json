{
  "name": "fullstack-work-sample-rahmat-hidayatullah",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "start": "vp run -r dev",
    "build": "vp run -r build",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "check-types": "vp run -r check-types",
    "test": "vp run -r test",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "env:generate": "varlock codegen --path ./apps/frontend/",
    "postinstall": "varlock codegen --path ./apps/frontend/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fullstack-work-sample-rahmat-hidayatullah/config": "workspace:*",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "rolldown": "1.2.15",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "packageManager": "bun@1.4.3"
}
